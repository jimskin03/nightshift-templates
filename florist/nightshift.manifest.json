{
  "$schema": "https://nightshift.local/schema/template-manifest.v2.json",
  "id": "florist",
  "name": "Florist / Bloom & Co",
  "description": "Editorial florist template for bouquets, events and local flower shops.",
  "version": 2,
  "entry": "index.html",
  "editor": {
    "groups": [
      "Brand",
      "Hero",
      "Features",
      "Gallery",
      "Contact & CTA",
      "Theme"
    ]
  },
  "fields": {
    "brandName": {
      "type": "string",
      "label": "Business name",
      "group": "Brand",
      "required": true,
      "maxLength": 80
    },
    "eyebrow": {
      "type": "string",
      "label": "Eyebrow",
      "group": "Hero",
      "required": true,
      "maxLength": 80
    },
    "tagline": {
      "type": "textarea",
      "label": "Hero tagline",
      "group": "Hero",
      "required": true,
      "maxLength": 220,
      "rows": 3
    },
    "primaryCta": {
      "type": "string",
      "label": "Primary button",
      "group": "Hero",
      "required": true,
      "maxLength": 50
    },
    "secondaryCta": {
      "type": "string",
      "label": "Secondary button",
      "group": "Hero",
      "required": true,
      "maxLength": 50
    },
    "featuresTitle": {
      "type": "string",
      "label": "Section title",
      "group": "Features",
      "required": true,
      "maxLength": 90
    },
    "featuresSubtitle": {
      "type": "string",
      "label": "Section subtitle",
      "group": "Features",
      "required": true,
      "maxLength": 160
    },
    "features": {
      "type": "array",
      "label": "Feature cards",
      "group": "Features",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "properties": {
          "title": {
            "type": "string",
            "label": "Title",
            "required": true,
            "maxLength": 70
          },
          "description": {
            "type": "textarea",
            "label": "Description",
            "required": true,
            "maxLength": 220,
            "rows": 2
          }
        }
      }
    },
    "galleryTitle": {
      "type": "string",
      "label": "Section title",
      "group": "Gallery",
      "required": true,
      "maxLength": 90
    },
    "gallerySubtitle": {
      "type": "string",
      "label": "Section subtitle",
      "group": "Gallery",
      "required": true,
      "maxLength": 160
    },
    "galleryItems": {
      "type": "array",
      "label": "Gallery / service cards",
      "group": "Gallery",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "properties": {
          "label": {
            "type": "string",
            "label": "Label",
            "required": true,
            "maxLength": 40
          },
          "title": {
            "type": "string",
            "label": "Title",
            "required": true,
            "maxLength": 70
          },
          "description": {
            "type": "textarea",
            "label": "Description",
            "required": true,
            "maxLength": 220,
            "rows": 2
          }
        }
      }
    },
    "ctaTitle": {
      "type": "textarea",
      "label": "CTA headline",
      "group": "Contact & CTA",
      "required": true,
      "maxLength": 180,
      "rows": 2
    },
    "ctaButton": {
      "type": "string",
      "label": "CTA button",
      "group": "Contact & CTA",
      "required": true,
      "maxLength": 50
    },
    "contactTitle": {
      "type": "string",
      "label": "Contact heading",
      "group": "Contact & CTA",
      "required": true,
      "maxLength": 70
    },
    "contactText": {
      "type": "textarea",
      "label": "Contact details",
      "group": "Contact & CTA",
      "required": true,
      "maxLength": 260,
      "rows": 3
    },
    "primaryColor": {
      "type": "color",
      "label": "Primary colour",
      "group": "Theme",
      "required": true
    },
    "secondaryColor": {
      "type": "color",
      "label": "Secondary colour",
      "group": "Theme",
      "required": true
    }
  },
  "defaults": {
    "brandName": "Bloom & Co",
    "eyebrow": "Florist · Flower shop",
    "tagline": "Seasonal stems from local growers, hand-tied and delivered across the city before noon.",
    "primaryCta": "Order a bouquet",
    "secondaryCta": "See this week's stems",
    "featuresTitle": "This week's stems",
    "featuresSubtitle": "What you get when you order from us.",
    "features": [
      {
        "title": "Cut this morning",
        "description": "We buy at the market daily, so nothing in the shop is older than a day."
      },
      {
        "title": "Delivered before noon",
        "description": "Order by 9am for same-day delivery anywhere inside the city."
      },
      {
        "title": "Arranged by hand",
        "description": "Every bouquet is tied in the shop — no pre-made bundles from a warehouse."
      }
    ],
    "galleryTitle": "This week in the shop",
    "gallerySubtitle": "Seasonal stems, wrapped and ready to go.",
    "galleryItems": [
      {
        "label": "Bouquets",
        "title": "Hand-tied bouquets",
        "description": "Seasonal stems wrapped the way you'd want to receive them."
      },
      {
        "label": "Weddings",
        "title": "Weddings & events",
        "description": "Ceremony, table, and buttonhole work, planned with you."
      },
      {
        "label": "Subscriptions",
        "title": "Standing orders",
        "description": "Fresh flowers on your desk or counter every week."
      },
      {
        "label": "Plants",
        "title": "House plants",
        "description": "Potted greenery that survives an ordinary flat."
      }
    ],
    "ctaTitle": "Open Tuesday to Sunday, 8am until the flowers run out.",
    "ctaButton": "Order a bouquet",
    "contactTitle": "Find us",
    "contactText": "Open Tuesday to Sunday, 9am to 6pm. 14 Rose Lane, city centre. Order by 9am for same-day delivery.",
    "primaryColor": "#be6590",
    "secondaryColor": "#d98ca8"
  },
  "bindings": {
    "text": {
      "brandName": [
        ".logo",
        ".hero h1"
      ],
      "eyebrow": ".hero .eyebrow",
      "tagline": ".hero .container > p",
      "primaryCta": ".hero .actions .btn:nth-child(1)",
      "secondaryCta": ".hero .actions .btn:nth-child(2)",
      "featuresTitle": "#features .section-head h2",
      "featuresSubtitle": "#features .section-head p",
      "galleryTitle": "#gallery .section-head h2",
      "gallerySubtitle": "#gallery .section-head p",
      "ctaTitle": ".cta .cta-box h2",
      "ctaButton": ".cta .btn",
      "contactTitle": "#contact .section-head h2",
      "contactText": "#contact .section-head p"
    },
    "cssVars": {
      "primaryColor": [
        "--primary-color",
        "--heading-from-color",
        "--link-color",
        "--on-tint-color"
      ],
      "secondaryColor": [
        "--secondary-color",
        "--heading-to-color",
        "--link-alt-color"
      ]
    },
    "lists": {
      "features": {
        "container": ".features",
        "kind": "features",
        "icon": "✦"
      },
      "galleryItems": {
        "container": ".gallery",
        "kind": "gallery",
        "linkText": "Find out more"
      }
    }
  }
}
